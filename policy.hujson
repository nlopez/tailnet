{
  "groups": {
    "group:k8s-readers": [
      "nlopez@github"
    ],
    "group:k8s-admins": [
      "nlopez@github"
    ],
  },
  "tagOwners": {
    // https://tailscale.com/kb/1236/kubernetes-operator?slug=kb&slug=1236&slug=kubernetes-operator#prerequisites
    "tag:k8s-operator": [],
    "tag:k8s": [
      "tag:k8s-operator"
    ],
    "tag:work": [
      "autogroup:admin"
    ],
    "tag:home": [
      "autogroup:admin",
      "tag:k8s-operator"
    ],
    "tag:lga1": [
      "autogroup:admin",
      "tag:k8s-operator"
    ],
    "tag:lga2": [
      "autogroup:admin"
    ],
    "tag:admin": [
      "autogroup:admin"
    ],
    "tag:container": [
      "autogroup:admin"
    ],
    "tag:k8s-readers": [
      "autogroup:admin"
    ],
    // Exit nodes — tag:exit is additive; existing location tags (tag:home, tag:lga1, tag:lga2)
    // must be preserved so subnet routing and autoApprovers still resolve.
    "tag:exit": [
      "autogroup:admin"
    ],
  },
  // needs support service enablement
  "autoApprovers": {
    "services": {
      "tag:k8s": [
        "tag:k8s"
      ],
    },
    // Redundant subnet router auto-approval for lga2 LAN (gw-lga2 and odroid-lga2)
    "routes": {
      "192.168.239.0/24": [
        "tag:lga2",
        "autogroup:admin"
      ],
    },
  },
  "grants": [
    // Non-work mesh: every non-work principal can reach every other non-work
    // principal (and the internet) on every port. tag:work is deliberately
    // absent from both src and dst — Tailscale grants have no negation, so
    // isolating work means enumerating everything that is NOT work here
    // rather than writing "* except tag:work". Keep this src/dst list in sync
    // with tagOwners when adding a new non-work tag.
    {
      "src": [
        "autogroup:member",
        "tag:admin",
        "tag:home",
        "tag:lga1",
        "tag:lga2",
        "tag:container",
        "tag:k8s",
        "tag:k8s-operator",
        "tag:k8s-readers",
        "tag:exit"
      ],
      "dst": [
        "autogroup:member",
        "autogroup:internet",
        "tag:admin",
        "tag:home",
        "tag:lga1",
        "tag:lga2",
        "tag:container",
        "tag:k8s",
        "tag:k8s-operator",
        "tag:k8s-readers",
        "tag:exit",
        "ipset:lga1",
        "ipset:lga2",
      ],
      "ip": [
        "*"
      ],
    },
    // Work machines → internet via tagged exit nodes ONLY. This is the sole
    // grant that references tag:work as a src, and nothing grants tag:work as
    // a dst — so all other tailnet traffic to and from work-tagged nodes is
    // denied. tag:work machines MUST NOT also carry tag:admin/tag:home/etc.
    {
      "src": [
        "tag:work"
      ],
      "dst": [
        "autogroup:internet"
      ],
      "via": [
        "tag:exit"
      ],
      "ip": [
        "*"
      ],
    },
    // k8s-admins → k8s-operator (k8s impersonate: system:masters)
    // Capability grants are NOT implied by the network grants above —
    // the tailscale.com/cap/kubernetes app capability must be granted
    // explicitly for the k8s operator to allow RBAC impersonation.
    {
      "src": [
        "group:k8s-admins",
        "tag:admin"
      ],
      "dst": [
        "tag:k8s-operator"
      ],
      "app": {
        "tailscale.com/cap/kubernetes": [
          {
            "impersonate": {
              "groups": [
                "system:masters"
              ],
            },
          }
        ],
      },
    },
    // k8s-readers → k8s-operator (k8s impersonate: tailnet-readers)
    {
      "src": [
        "group:k8s-readers"
      ],
      "dst": [
        "tag:k8s-operator"
      ],
      "app": {
        "tailscale.com/cap/kubernetes": [
          {
            "impersonate": {
              "groups": [
                "tailnet-readers"
              ],
            },
          }
        ],
      },
    },
  ],
  "ipsets": {
    "ipset:lga1": [
      "192.168.221.0/24",
      "192.168.222.0/24",
      "192.168.223.0/24",
      "10.43.0.0/16",
    ],
    "ipset:lga2": [
      "192.168.239.0/24",
    ],
    "ipset:home": [
      "ipset:lga1",
      "ipset:lga2",
    ],
    "ipset:k8s-api": [
      "192.168.222.245",
    ],
  },
  "ssh": [
    // ssh: only tag:admin machines can SSH; excluded: tag:work
    {
      "action": "accept",
      "src": [
        "tag:admin"
      ],
      "dst": [
        "tag:k8s-operator",
        "tag:home",
        "tag:lga1",
        "tag:lga2",
        "tag:admin",
        "tag:container",
        "tag:exit",
      ],
      "users": [
        "autogroup:nonroot",
        "root"
      ]
    },
  ],
  // https://tailscale.com/kb/1337/acl-syntax#randomizeclientport
  "randomizeClientPort": true,
  "nodeAttrs": [
    // Use Work NextDNS profile for work tagged Tailscale machines
    // https://tailscale.com/kb/1218/nextdns#use-different-nextdns-profiles-for-different-devices
    {
      "target": [
        "tag:work"
      ],
      "attr": [
        "nextdns:37848c",
        "disable-ipv4",
      ]
    },
    {
      "target": [
        "autogroup:member"
      ],
      "attr": [
        "funnel"
      ],
    },
    {
      "target": [
        "tag:admin"
      ],
      "attr": [
        "funnel"
      ],
    },
  ],
  // sshTests removed: autogroup:member not allowed as src in sshTests;
  // self-SSH MFA handled by autogroup:member → autogroup:self check rule
  "tests": [
    // home machines can access common service ports on other home machines
    {
      "src": "tag:home",
      "accept": [
        "tag:home:8080",
        "tag:home:80",
        "tag:home:443"
      ]
    },
    // admin can SSH to all tagged machines except tag:work, and can use exit nodes
    {
      "src": "tag:admin",
      "accept": [
        "tag:k8s-operator:22",
        "tag:home:22",
        "tag:lga1:22",
        "tag:lga2:22",
        "tag:admin:22",
        "tag:container:22",
        "tag:exit:22",
        "1.1.1.1:53",
      ],
    },
    // work can only reach the internet (via exit nodes); all other tailnet
    // traffic to/from work-tagged nodes is denied — no LAN, no home, no k8s,
    // no other work.
    {
      "src": "tag:work",
      "accept": [
        "1.1.1.1:53",
      ],
      "deny": [
        "10.43.64.1:22",
        "10.43.64.1:443",
        "tag:home:22",
        "tag:home:80",
        "tag:home:443",
        "tag:home:8080",
        "tag:lga1:22",
        "tag:lga1:443",
        "tag:lga2:443",
        "tag:work:22",
        "tag:work:80",
        "tag:work:443",
        "tag:k8s-operator:443",
        "tag:admin:22",
      ],
    },
    // k8s-readers can connect to k8s operator
    {
      "src": "nlopez@github",
      "accept": [
        "tag:k8s-operator:443",
      ],
    },
    // admin can connect to k8s operator
    {
      "src": "tag:admin",
      "accept": [
        "tag:k8s-operator:443",
      ],
    },
    // admin can reach all ipset:lga1 subnets (192.168.221-223.0/24)
    {
      "src": "tag:admin",
      "accept": [
        "192.168.221.1:22",
        "192.168.222.1:22",
        "192.168.223.1:22",
      ],
    }
  ],
}
