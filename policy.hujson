{
  "groups": {
    "group:k8s-readers": [
      "nlopez@github"
    ],
    "group:k8s-admins": [
      "nlopez@github"
    ],
  },
  "tagOwners": {
    // https://tailscale.com/kb/1236/kubernetes-operator?slug=kb&slug=1236&slug=kubernetes-operator#prerequisites
    "tag:k8s-operator": [],
    "tag:k8s": [
      "tag:k8s-operator"
    ],
    "tag:work": [
      "autogroup:admin"
    ],
    "tag:home": [
      "autogroup:admin",
      "tag:k8s-operator"
    ],
    "tag:lga1": [
      "autogroup:admin",
      "tag:k8s-operator"
    ],
    "tag:lga2": [
      "autogroup:admin"
    ],
    "tag:admin": [
      "autogroup:admin"
    ],
    "tag:container": [
      "autogroup:admin"
    ],
    "tag:k8s-readers": [
      "autogroup:admin"
    ],
    // Exit nodes — tag:exit is additive; existing location tags (tag:home, tag:lga1, tag:lga2)
    // must be preserved so subnet routing and autoApprovers still resolve.
    "tag:exit": [
      "autogroup:admin",
      "tag:k8s-operator"
    ],
    // Timekeeper Sync droplets (ash, oak), joined by cloud-init in KamoTimestamps/timekeeper (infra/).
    // Auth keys for them are generated by an admin with this tag.
    "tag:timekeeper": [
      "autogroup:admin"
    ],
  },
  // needs support service enablement
  "autoApprovers": {
    "exitNode": [
      "tag:exit"
    ],
    "services": {
      "tag:k8s": [
        "tag:k8s"
      ],
    },
    // Redundant subnet router auto-approval for lga2 LAN (gw-lga2 and odroid-lga2)
    "routes": {
      "192.168.239.0/24": [
        "tag:lga2",
        "autogroup:admin"
      ],
      // k8s LoadBalancer service subnet, advertised by the k8s-operator subnet
      // router. Auto-approving the route (rather than just granting network
      // access) is what actually makes it reachable tailnet-wide — the
      // allow-all grant below already permits every src, including tag:work.
      "10.43.64.0/24": [
        "tag:k8s-operator",
        "tag:lga1"
      ],
      // lga1 LANs, advertised by the lga1 subnet routers.
      "192.168.221.0/24": [
        "tag:lga1"
      ],
      "192.168.222.0/24": [
        "tag:lga1"
      ],
      "192.168.223.0/24": [
        "tag:lga1"
      ],
      // 4via6 form of the same subnet (site ID 1), for devices that cannot
      // use the IPv4 route (overlapping LANs, tag:work has disable-ipv4).
      "fd7a:115c:a1e0:b1a:0:1:a2b:4000/120": [
        "tag:lga1"
      ],
    },
  },
  "grants": [
    // Default deny: only tag:admin can reach every destination on every port.
    {
      "src": [
        "tag:admin"
      ],
      "dst": [
        "*"
      ],
      "ip": [
        "*"
      ],
    },
    // Every device can reach the internal envoy gateway (k8s LoadBalancer
    // subnet, advertised by the k8s-operator subnet router).
    {
      "src": [
        "*"
      ],
      "dst": [
        "10.43.64.0/24"
      ],
      "ip": [
        "*"
      ],
    },
    // 4via6 form of the same subnet (site ID 1).
    {
      "src": [
        "*"
      ],
      "dst": [
        "fd7a:115c:a1e0:b1a:0:1:a2b:4000/120"
      ],
      "ip": [
        "*"
      ],
      "via": [
        "tag:lga1"
      ],
    },
    // Any device can use any exit node (internet access only).
    {
      "src": [
        "*"
      ],
      "dst": [
        "autogroup:internet"
      ],
      "ip": [
        "*"
      ],
    },
    // Home machines can reach each other on any port.
    {
      "src": [
        "tag:home"
      ],
      "dst": [
        "tag:home"
      ],
      "ip": [
        "*"
      ],
    },
    // Site-to-site: hosts behind the lga1 and lga2 subnet routers can reach
    // each other, and tag:home devices can reach those subnets.
    {
      "src": [
        "ipset:home",
        "tag:home"
      ],
      "dst": [
        "ipset:home",
        "tag:home"
      ],
      "ip": [
        "*"
      ],
    },
    // k8s-admins → k8s-operator (k8s impersonate: system:masters)
    // Capability grants are NOT implied by the network allow-all above —
    // the tailscale.com/cap/kubernetes app capability must be granted
    // explicitly for the k8s operator to allow RBAC impersonation.
    {
      "src": [
        "group:k8s-admins",
        "tag:admin"
      ],
      "dst": [
        "tag:k8s-operator"
      ],
      "app": {
        "tailscale.com/cap/kubernetes": [
          {
            "impersonate": {
              "groups": [
                "system:masters"
              ],
            },
          }
        ],
      },
    },
    // k8s-readers → k8s-operator (k8s impersonate: tailnet-readers)
    {
      "src": [
        "group:k8s-readers"
      ],
      "dst": [
        "tag:k8s-operator"
      ],
      "app": {
        "tailscale.com/cap/kubernetes": [
          {
            "impersonate": {
              "groups": [
                "tailnet-readers"
              ],
            },
          }
        ],
      },
    },
  ],
  "ipsets": {
    "ipset:lga1": [
      "192.168.221.0/24",
      "192.168.222.0/24",
      "192.168.223.0/24",
      "10.43.0.0/16",
    ],
    "ipset:lga2": [
      "192.168.239.0/24",
    ],
    "ipset:home": [
      "ipset:lga1",
      "ipset:lga2",
    ],
    "ipset:k8s-api": [
      "192.168.222.245",
    ],
  },
  "ssh": [
    // ssh: only tag:admin machines can SSH as root or any non-root user; excluded: tag:work
    {
      "action": "accept",
      "src": [
        "tag:admin"
      ],
      "dst": [
        "tag:k8s-operator",
        "tag:home",
        "tag:lga1",
        "tag:lga2",
        "tag:admin",
        "tag:container",
        "tag:exit",
        "tag:timekeeper",
      ],
      "users": [
        "autogroup:nonroot",
        "root"
      ]
    },
  ],
  // https://tailscale.com/kb/1337/acl-syntax#randomizeclientport
  "randomizeClientPort": true,
  "nodeAttrs": [
    // Use Work NextDNS profile for work tagged Tailscale machines
    // https://tailscale.com/kb/1218/nextdns#use-different-nextdns-profiles-for-different-devices
    {
      "target": [
        "tag:work"
      ],
      "attr": [
        "nextdns:37848c",
        "disable-ipv4",
      ]
    },
    {
      "target": [
        "autogroup:member"
      ],
      "attr": [
        "funnel"
      ],
    },
    {
      "target": [
        "tag:admin"
      ],
      "attr": [
        "funnel"
      ],
    },
  ],
  // sshTests removed: autogroup:member not allowed as src in sshTests;
  // self-SSH MFA handled by autogroup:member → autogroup:self check rule
  "tests": [
    // admin can reach everything
    {
      "src": "tag:admin",
      "accept": [
        "tag:k8s-operator:22",
        "tag:home:22",
        "tag:lga1:22",
        "tag:lga2:22",
        "tag:admin:22",
        "tag:container:22",
        "tag:exit:22",
        "tag:timekeeper:22",
        "tag:work:22",
        "tag:k8s-operator:443",
        "1.1.1.1:53",
        "192.168.221.1:22",
        "192.168.222.1:22",
        "192.168.223.1:22",
      ],
    },
    // every non-admin device can reach the envoy gateway and nothing else on
    // the tailnet
    {
      "src": "tag:work",
      "accept": [
        "10.43.64.10:443",
        "10.43.64.1:443",
        "1.1.1.1:53",
      ],
      "deny": [
        "192.168.239.2:53",
        "tag:home:22",
        "tag:home:443",
        "tag:admin:22",
        "tag:k8s-operator:443",
      ],
    },
    {
      "src": "tag:home",
      "accept": [
        "10.43.64.10:443",
        "tag:home:8080",
        "tag:home:80",
        "tag:home:443",
      ],
      "deny": [
        "tag:work:22",
        "tag:admin:22",
      ],
    },
    {
      "src": "tag:container",
      "accept": [
        "10.43.64.10:443",
      ],
      "deny": [
        "tag:home:22",
        "tag:admin:22",
      ],
    },
  ],
}
